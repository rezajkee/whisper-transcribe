# Скопируйте в config.env и при необходимости измените:
# cp config.env.example config.env

WHISPER_VENV="$HOME/whisper-env"
WHISPER_OUTPUT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/result"
WHISPER_WORK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/work"

WHISPER_LANGUAGE=ru
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8
WHISPER_MIN_SPEAKERS=2

# Для diarization (разделение голосов)
WHISPER_DIARIZE_MODEL=pyannote/speaker-diarization-3.1
