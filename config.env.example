# Скопируйте в config.env и при необходимости измените:
# cp config.env.example config.env

WHISPER_VENV="$HOME/whisper-env"
WHISPER_OUTPUT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/result"
WHISPER_WORK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/work"

WHISPER_LANGUAGE=ru
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8
WHISPER_MIN_SPEAKERS=2

# Для diarization (разделение голосов)
WHISPER_DIARIZE_MODEL=pyannote/speaker-diarization-3.1

# Изолированное окружение MLX для явных --engine parakeet/nemotron/dual.
# Обычный запуск остаётся WhisperX; подготовка моделей — scripts/setup_mlx.sh.
WHISPER_MLX_VENV="$HOME/whisper-mlx-env"

# Новый pipeline: число CPU-потоков для WhisperX/выравнивания/pyannote.
WHISPER_CPU_THREADS=4
# Словарь передаётся через --glossary FILE только вместе с --engine dual.
# Загрузка моделей разрешена только явной подготовкой:
# scripts/setup_mlx.sh --prefetch
